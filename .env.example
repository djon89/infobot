# ===== Telegram =====
# Токен от @BotFather
BOT_TOKEN=
# Ваш Telegram ID (через запятую, если владельцев несколько)
OWNER_IDS=
# allowlist — только вы и ALLOWLIST_IDS; public — все
ACCESS_MODE=allowlist
ALLOWLIST_IDS=
# Видео за 24 часа на обычного пользователя
DAILY_LIMIT=10

# ===== LLM =====
# Для вас: подписка Claude Code. Для остальных: официальный API
LLM_PROVIDER_OWNER=claude_cli
LLM_PROVIDER_PUBLIC=anthropic
# Получается командой `claude setup-token` (установщик делает это сам)
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CLI_MODEL=opus
# Нужен только для ACCESS_MODE=public (console.anthropic.com)
ANTHROPIC_API_KEY=
# claude-haiku-5-5 — примерно в 40 раз дешевле
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# ===== YouTube: прокси против блокировок =====
TRANSCRIPT_LANGUAGES=ru,en
# Webshare Residential → Proxy Settings
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
# Или любой другой: http://user:pass@host:port
GENERIC_PROXY_URL=

# ===== Инфраструктура (менять не нужно) =====
DATABASE_URL=postgresql+asyncpg://bot:bot@postgres:5432/bot
REDIS_URL=redis://redis:6379/0
