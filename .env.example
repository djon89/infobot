# --- Telegram ---
BOT_TOKEN=123456:ABC...            # от @BotFather
OWNER_IDS=111111111                # ваш Telegram ID (узнать: @userinfobot), через запятую
ACCESS_MODE=public                 # public | allowlist
ALLOWLIST_IDS=
DAILY_LIMIT=10                     # видео за 24 часа на обычного пользователя

# --- LLM ---
LLM_PROVIDER_OWNER=claude_cli      # вы: подписка Claude Code
LLM_PROVIDER_PUBLIC=anthropic      # остальные: официальный API
CLAUDE_CODE_OAUTH_TOKEN=           # `claude setup-token` на своём компьютере
CLAUDE_CLI_MODEL=opus
ANTHROPIC_API_KEY=                 # console.anthropic.com
ANTHROPIC_MODEL=claude-opus-5-5    # claude-haiku-5-5 — примерно в 40 раз дешевле
ANTHROPIC_EFFORT=medium

# --- YouTube (против блокировок IP сервера) ---
TRANSCRIPT_LANGUAGES=ru,en
WEBSHARE_PROXY_USERNAME=           # резидентный прокси Webshare (рекомендуется)
WEBSHARE_PROXY_PASSWORD=
GENERIC_PROXY_URL=                 # либо любой http://user:pass@host:port

# --- Infra (для docker-compose менять не нужно) ---
DATABASE_URL=postgresql+asyncpg://bot:bot@postgres:5432/bot
REDIS_URL=redis://redis:6379/0
