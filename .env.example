# ===== Telegram =====
# Токен от @BotFather
BOT_TOKEN=
# Ваш Telegram ID (через запятую, если владельцев несколько)
OWNER_IDS=
# allowlist — только вы и ALLOWLIST_IDS; public — все
ACCESS_MODE=allowlist
ALLOWLIST_IDS=
# Видео за 24 часа на обычного пользователя
DAILY_LIMIT=10

# ===== LLM =====
# Для вас: подписка Claude Code. Для остальных: официальный API
LLM_PROVIDER_OWNER=claude_cli
LLM_PROVIDER_PUBLIC=anthropic
# Получается командой `claude setup-token` (установщик делает это сам)
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CLI_MODEL=opus
# Нужен только для ACCESS_MODE=public (console.anthropic.com)
ANTHROPIC_API_KEY=
# claude-haiku-5-5 — примерно в 40 раз дешевле
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# ===== YouTube: прокси против блокировок =====
TRANSCRIPT_LANGUAGES=ru,en
# Webshare Residential → Proxy Settings
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
# Или любой другой: http://user:pass@host:port
GENERIC_PROXY_URL=

# ===== Инфраструктура (менять не нужно) =====
DATABASE_URL=postgresql+asyncpg://bot:bot@postgres:5432/bot
REDIS_URL=redis://redis:6379/0

# ===== Скачивание видео =====
# Свой сервер Telegram Bot API (файлы до 2 ГБ). Данные — с my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Когда заполнены две строки выше, установщик сам выставит эти две:
TELEGRAM_API_URL=
COMPOSE_PROFILES=
# Качество по умолчанию: 360 | 480 | 720 | 1080 | best | audio
DEFAULT_QUALITY=720
# Дорожка по умолчанию: orig | ru | en
DEFAULT_AUDIO=orig
# Прокси для скачивания (НЕ ротирующий): используется, если напрямую YouTube не отдал
YTDLP_PROXY=

# ===== Сводка новых видео =====
DEFAULT_TZ=Europe/Moscow
# Час ежедневной сводки по умолчанию (пользователь меняет в /settings)
DEFAULT_DIGEST_HOUR=9
# Импорт подписок YouTube: Google Cloud → OAuth client «TVs and Limited Input devices»
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
